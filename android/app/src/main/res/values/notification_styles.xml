<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ongoing prayer-times notification. Parents follow the system notification
         theme so text stays readable on both light and dark shades. -->
    <color name="notif_accent">#F59E0B</color>

    <style name="NotifCity" parent="TextAppearance.Compat.Notification.Title">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="NotifNextLabel" parent="TextAppearance.Compat.Notification.Info">
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="NotifCountdown" parent="TextAppearance.Compat.Notification.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/notif_accent</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="NotifCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginStart">1dp</item>
        <item name="android:layout_marginEnd">1dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <style name="NotifLabel" parent="TextAppearance.Compat.Notification.Info">
        <item name="android:textSize">11sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="NotifTime" parent="TextAppearance.Compat.Notification.Title">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="NotifTimeCompact" parent="NotifTime">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
